<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#202020" />

        <!-- 点阵颜色 -->
        <TextView
            android:id="@+id/sectionColorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="点阵颜色"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#616161" />

        <TextView
            android:id="@+id/colorHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="选择后，App 和桌面小组件的点阵与百分比文字会同步变色"
            android:textSize="13sp"
            android:textColor="#9E9E9E" />

        <LinearLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <!-- 进度显示方式 -->
        <TextView
            android:id="@+id/sectionProgressTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="进度显示"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#616161" />

        <TextView
            android:id="@+id/progressHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="选择进度行显示「已过多少天」还是「剩余多少天」"
            android:textSize="13sp"
            android:textColor="#9E9E9E" />

        <LinearLayout
            android:id="@+id/modeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/previewLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="预览：进度 已过 295 天 / 365 天"
            android:textSize="16sp"
            android:textColor="#424242"
            android:fontFamily="serif" />
    </LinearLayout>
</ScrollView>
