<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#202020" />

        <!-- 进度类型切换 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="进度类型"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#616161" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="切换后，主界面显示方式不同；下方各设置项按类型独立调节"
            android:textSize="13sp"
            android:textColor="#9E9E9E" />

        <LinearLayout
            android:id="@+id/modeTypeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <!-- 人生进度专属设置 -->
        <LinearLayout
            android:id="@+id/lifeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/birthRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="出生日期"
                    android:textSize="16sp"
                    android:textColor="#202020" />

                <TextView
                    android:id="@+id/birthVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2000年1月1日"
                    android:textSize="16sp"
                    android:textColor="#616161" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/expectRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="预计寿命"
                    android:textSize="16sp"
                    android:textColor="#202020" />

                <TextView
                    android:id="@+id/expectVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80岁"
                    android:textSize="16sp"
                    android:textColor="#616161" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="有效时间"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#616161" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="减去睡觉/上班（各约占1/3）与低质量时间（约15%）占用的时间，可叠加"
                android:textSize="13sp"
                android:textColor="#9E9E9E" />

            <Switch
                android:id="@+id/swSleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="减去睡觉（约占 1/3）"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swWork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="减去上班（约占 1/3）"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swLowq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="减去低质量时间（约 15%）"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 点阵颜色 -->
        <TextView
            android:id="@+id/sectionColorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="点阵颜色"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#616161" />

        <TextView
            android:id="@+id/colorHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="选择后，App 和桌面小组件的点阵与百分比文字会同步变色"
            android:textSize="13sp"
            android:textColor="#9E9E9E" />

        <LinearLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <!-- 进度显示方式 -->
        <TextView
            android:id="@+id/sectionProgressTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="进度显示"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#616161" />

        <TextView
            android:id="@+id/progressHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="选择进度行显示「已过多少天」还是「剩余多少天」"
            android:textSize="13sp"
            android:textColor="#9E9E9E" />

        <LinearLayout
            android:id="@+id/modeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/previewLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="预览：进度 已过 295 天 / 365 天"
            android:textSize="16sp"
            android:textColor="#424242"
            android:fontFamily="serif" />
    </LinearLayout>
</ScrollView>
